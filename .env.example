# Dev playground defaults (`pnpm dev`). Copy to `.env` and fill in.
# Both are optional; values saved in the playground form take precedence.

# Calendar ID, e.g. xxxx@group.calendar.google.com (Calendar settings > Integrate calendar)
GOOGLE_CALENDAR_ID=

# Google Calendar API key. Leave empty to fall back to the public iCal feed.
PUBLIC_GOOGLE_CALENDAR_API_KEY=
